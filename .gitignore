# Never commit credentials or pi runtime state.
.pi/agent/auth.json
.pi/agent/mcp-auth.json
**/mcp-auth*
.pi/agent/models.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/ui-panels.json
.pi/agent/api-usage.cache
.pi/agent/opencode-bridge-policy.log
.pi/agent/sessions/
.pi/agent/spill/
.pi/agent/checkpoints/
.pi/agent/backups/
.pi/agent/cache/
.pi/agent/tmp/
.pi/agent/install/
.pi/agent/npm/
.pi/agent/git/

# Machine-local identity, credentials, and overrides.
.bashrc.local
.zshrc.local
.profile.local
.gitconfig.local
.git-credentials
.netrc
.env
.env.*
!.env.example
.ssh/
.password-store/
.aws/
.gnupg/
.config/gh/hosts.yml
.docker/config.json
.kube/config
*.pem
*.key
*.p12
*.pfx
*.ppk
cookies.txt
cookies.sqlite
cookies/
*.cookie

# Host-private notes and local-only commercial skill content.
.pi/agent/machine-idle-plan.md
.pi/agent/dsh-sync-plan.md
.pi/agent/unfinished-work.md
.pi/agent/wifi-*.md
.pi/agent/skills/frontend-design/

# Backups, archives, and runtime state.
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*.tmp
*.pid
*.sock
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
.dotfiles-backup-*/
.backups/
*~
.DS_Store

# Dependencies and build output.
node_modules/
dist/
*.log

# Runtime wallpaper state, regenerated by wppicker/restore scripts.
.config/hypr/current_wallpaper
.config/rofi/current_wallpaper.png
.config/waybar-niri/current_wallpaper

# Python bytecode.
__pycache__/
*.pyc
