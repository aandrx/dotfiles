#!/usr/bin/env bash
# waybar-profile - switch waybar profiles without killing the bar.
#
# A profile is a directory under ~/.config/waybar-niri/profiles/ containing
# config.jsonc and style.css. The bar must be launched through the stable
# symlink ~/.config/waybar-niri/current so that a reload picks up a new
# profile. The `current` symlink is the source of truth; the state file only
# records history for `revert`.
set -euo pipefail

DIR="${WAYBAR_PROFILE_DIR:-$HOME/.config/waybar-niri}"
PROFILES="$DIR/profiles"
CURRENT="$DIR/current"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/waybar"
LOG="$STATE/swap.log"
UNIT="waybar-manual"
CONFIG_REF="$DIR/config.jsonc"
STYLE_REF="$DIR/style.css"

mkdir -p "$STATE"
exec 9>"$STATE/lock"
if ! flock -n 9; then
  echo "waybar-profile: another instance is running" >&2
  exit 1
fi

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }
say() { printf '%s\n' "$*"; }
err() { printf 'waybar-profile: %s\n' "$*" >&2; }

bar_pids() { pgrep -x waybar || true; }

single_pid() {
  local pids; pids=$(bar_pids)
  if [ -z "$pids" ]; then err "waybar is not running"; return 1; fi
  if [ "$(printf '%s\n' "$pids" | wc -l)" -ne 1 ]; then
    err "more than one waybar is running: $(printf '%s ' $pids)"
    err "refusing to act; resolve duplicates first"
    return 1
  fi
  printf '%s\n' "$pids"
}

# Reads the -c/-s paths the running bar was launched with.
bar_cmdline() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null || true; }

on_stable_paths() {
  case "$(bar_cmdline "$1")" in
    *"$CURRENT/config.jsonc"*) return 0 ;;
  esac
  return 1
}

current_name() {
  if [ -L "$CURRENT" ]; then basename "$(readlink "$CURRENT")"; else echo "(none)"; fi
}

profile_dir() { printf '%s/%s\n' "$PROFILES" "$1"; }

# Validates a profile without launching anything: JSONC parses, module names in
# modules-* exist as top-level keys, and every @import resolves.
validate_profile() {
  local name="$1" d; d=$(profile_dir "$name")
  [ -d "$d" ] || { err "no such profile: $name"; return 1; }
  [ -f "$d/config.jsonc" ] || { err "$name: missing config.jsonc"; return 1; }
  [ -f "$d/style.css" ]    || { err "$name: missing style.css"; return 1; }

  python3 - "$d/config.jsonc" <<'PY' || return 1
import json, sys

path = sys.argv[1]
raw = open(path, encoding="utf-8").read()

# Strip comments and trailing commas while respecting string literals.
out = []
i = 0
n = len(raw)
in_str = False
esc = False
while i < n:
    ch = raw[i]
    if in_str:
        out.append(ch)
        if esc:
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == '"':
            in_str = False
        i += 1
        continue
    if ch == '"':
        in_str = True
        out.append(ch)
        i += 1
        continue
    if raw.startswith("//", i):
        while i < n and raw[i] != "\n":
            i += 1
        continue
    if raw.startswith("/*", i):
        j = raw.find("*/", i + 2)
        i = n if j < 0 else j + 2
        continue
    out.append(ch)
    i += 1

clean = "".join(out)
result = []
for idx, ch in enumerate(clean):
    if ch == ",":
        j = idx + 1
        while j < len(clean) and clean[j] in " \t\r\n":
            j += 1
        if j < len(clean) and clean[j] in "}]":
            continue
    result.append(ch)
text = "".join(result)

try:
    cfg = json.loads(text)
except json.JSONDecodeError as e:
    print(f"invalid JSONC in {path}: {e}", file=sys.stderr)
    sys.exit(1)

mods = set()
for key in ("modules-left", "modules-center", "modules-right"):
    value = cfg.get(key)
    if isinstance(value, list):
        mods.update(value)
missing = sorted(m for m in mods if m not in cfg)
if missing:
    print(f"modules referenced but not defined: {', '.join(missing)}", file=sys.stderr)
    sys.exit(1)
PY

  local imp target
  while IFS= read -r imp; do
    target="$d/$imp"
    [ -e "$target" ] || { err "$name: @import \"$imp\" does not resolve"; return 1; }
  done < <(grep -o '@import "[^"]*"' "$d/style.css" | sed 's/@import "//; s/"$//')

  say "ok: $name"
}

# Atomically repoints $CURRENT at the named profile.
point_current() {
  local name="$1" tmp="$DIR/.current.$$"
  rm -f "$tmp"
  ln -s "profiles/$name" "$tmp"
  mv -T "$tmp" "$CURRENT"
}

set_previous() {
  local prev; prev=$(current_name)
  [ "$prev" = "(none)" ] && return 0
  printf '%s\n' "$prev" >"$STATE/previous"
}

# Drops a recorded previous profile that no longer exists.
prune_previous() {
  [ -s "$STATE/previous" ] || return 0
  local prev; prev=$(cat "$STATE/previous")
  [ -d "$(profile_dir "$prev")" ] || rm -f "$STATE/previous"
}

cmd_list() {
  local d n mark
  for d in "$PROFILES"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d"); mark=" "
    [ "$n" = "$(current_name)" ] && mark="*"
    printf '%s %s\n' "$mark" "$n"
  done
}

cmd_status() {
  local pid pids
  prune_previous
  pids=$(bar_pids)
  say "profile:   $(current_name)"
  say "profiles:  $(cmd_list | wc -l)"
  if [ -z "$pids" ]; then
    say "bar:       not running"
  else
    for pid in $pids; do
      say "bar:       pid $pid"
      say "cmdline:   $(bar_cmdline "$pid")"
      if on_stable_paths "$pid"; then
        say "paths:     stable (reload can switch profiles)"
      else
        say "paths:     direct (reload cannot switch; needs --restart once)"
      fi
    done
  fi
  local name; name=$(current_name)
  # Drift only means something for the profile that mirrors the canonical
  # top-level files; other profiles are expected to differ.
  if [ "$name" = "status" ] && [ -f "$(profile_dir status)/config.jsonc" ]; then
    local d; d=$(profile_dir status)
    if cmp -s "$d/config.jsonc" "$CONFIG_REF" && cmp -s "$d/style.css" "$STYLE_REF"; then
      say "drift:     none (status profile matches $DIR top-level files)"
    else
      say "drift:     status profile differs from top-level config.jsonc/style.css; run: waybar-profile sync status"
    fi
  fi
  if [ -s "$STATE/previous" ]; then say "previous:  $(cat "$STATE/previous")"; fi
}

cmd_use() {
  local name="" restart=0 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --restart) restart=1 ;;
      --dry-run|-n) dry=1 ;;
      -*) err "unknown option: $1"; return 2 ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || { err "usage: waybar-profile use <name> [--restart] [--dry-run]"; return 2; }
  [ -d "$(profile_dir "$name")" ] || { err "no such profile: $name"; return 2; }
  prune_previous

  if [ "$name" = "$(current_name)" ]; then
    say "already on '$name'"
    return 0
  fi

  validate_profile "$name" >/dev/null || { err "profile failed validation; not switching"; return 1; }

  local pid stable=0
  pid=$(single_pid) || { err "no single bar to switch; nothing changed"; return 1; }
  on_stable_paths "$pid" && stable=1

  if [ $dry -eq 1 ]; then
    say "would switch: $(current_name) -> $name"
    say "running bar: pid $pid, stable paths: $([ $stable -eq 1 ] && echo yes || echo no)"
    say "action:      $([ $stable -eq 1 ] && echo 'SIGUSR2 reload' || echo 'restart required')"
    return 0
  fi

  if [ $stable -eq 0 ] && [ $restart -eq 0 ]; then
    err "the running bar was launched with direct paths, so a reload would not pick up '$name'."
    err "re-run with --restart to replace it, or leave it until the next session starts through current/."
    return 3
  fi

  set_previous
  point_current "$name"
  log "switch -> $name (restart=$restart)"

  if [ $stable -eq 1 ] && [ $restart -eq 0 ]; then
    kill -USR2 "$pid"
    say "switched to '$name' (reloaded pid $pid)"
  else
    restart_bar
    say "switched to '$name' (bar restarted)"
  fi
}

restart_bar() {
  stop_bar >/dev/null || true
  start_bar
}

# The bar runs under a transient user unit so it is not tied to the cgroup of
# whatever terminal happened to launch it, and so a stop takes the whole group
# with it (including the long-lived swaync-client child).
stop_bar() {
  if systemctl --user is-active --quiet "$UNIT.service" 2>/dev/null; then
    systemctl --user stop "$UNIT.service"
    say "stopped $UNIT.service"
    return 0
  fi
  local pid
  if pid=$(single_pid 2>/dev/null); then
    kill -TERM "$pid"
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
      i=$((i + 1))
      if [ $i -ge 30 ]; then
        err "pid $pid did not exit after SIGTERM; not force-killing"
        return 1
      fi
      sleep 0.1
    done
    say "stopped pid $pid"
    return 0
  fi
  err "waybar is not running"
  return 1
}

start_bar() {
  [ -f "$CURRENT/config.jsonc" ] || { err "$CURRENT/config.jsonc missing"; return 1; }
  [ -f "$CURRENT/style.css" ]    || { err "$CURRENT/style.css missing"; return 1; }

  if command -v systemd-run >/dev/null 2>&1; then
    systemctl --user reset-failed "$UNIT.service" >/dev/null 2>&1 || true
    systemd-run --user --collect --unit="$UNIT" -p Type=exec -- \
      waybar -c "$CURRENT/config.jsonc" -s "$CURRENT/style.css" >/dev/null
  else
    setsid waybar -c "$CURRENT/config.jsonc" -s "$CURRENT/style.css" \
      >>"$STATE/waybar.log" 2>&1 &
  fi

  local i=0
  while [ $i -lt 50 ]; do
    if [ -n "$(bar_pids)" ]; then
      say "started pid $(bar_pids)"
      return 0
    fi
    i=$((i + 1)); sleep 0.1
  done
  err "waybar did not start; see journalctl --user -u $UNIT or $STATE/waybar.log"
  return 1
}

cmd_revert() {
  prune_previous
  [ -s "$STATE/previous" ] || { err "no previous profile recorded"; return 1; }
  cmd_use "$(cat "$STATE/previous")" "$@"
}

cmd_sync() {
  local name="${1:-status}" d; d=$(profile_dir "$name")
  [ -d "$d" ] || { err "no such profile: $name"; return 2; }
  cp -p "$CONFIG_REF" "$d/config.jsonc"
  cp -p "$STYLE_REF" "$d/style.css"
  say "synced $name from top-level config.jsonc/style.css"
}

case "${1:-}" in
  list)    cmd_list ;;
  status)  cmd_status ;;
  current) current_name ;;
  validate) shift; validate_profile "${1:?usage: validate <name>}" ;;
  use)     shift; cmd_use "$@" ;;
  revert)  shift; cmd_revert "$@" ;;
  sync)    shift; cmd_sync "$@" ;;
  start)   start_bar ;;
  restart) restart_bar ;;
  stop)    stop_bar ;;
  *) cat <<'USAGE'
usage: waybar-profile <command>

  list                 profiles, '*' marks the current one
  status               running bar, launch paths, drift, history
  current              print the current profile name
  validate <name>      check JSONC, module names and @imports
  use <name>           switch (reload when possible, else needs --restart)
  revert               switch back to the previous profile
  sync [status]        copy top-level config.jsonc/style.css into a profile
  start | stop         start or stop the bar through current/
USAGE
     ;;
esac
