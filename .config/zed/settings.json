// Zed settings example. Docs: https://zed.dev/docs/configuring-zed
{
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },

  "ui_font_family": "JetBrainsMono Nerd Font Propo",
  "ui_font_size": 15.0,
  "ui_font_weight": 500.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Propo",
  "buffer_font_size": 15.0,
  "buffer_font_features": {
    "calt": false,
  },

  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "working_directory": "current_project_directory",
  },

  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "One Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",

  "vim_mode": false,
  "soft_wrap": "editor_width",

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
