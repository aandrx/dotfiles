/* Sample palette. On the author's machine matugen writes this file from the
 * current wallpaper; the theme uses only these names. */
* {
    primary: #bec2ff;
    primary-fixed: #e0e0ff;
    on-primary: #272b60;
    on-primary-fixed: #11144b;
    on-secondary: #272b60;
    on-surface: #e4e1e9;
    secondary-container: #3e4278;
    error: #ffb4ab;
}
