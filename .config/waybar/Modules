// Module definitions, included by every layout in configs/.
{
"clock": {
	"interval": 1,
	"format": "{:%H:%M}",
	"format-alt": "{:%a %e, %B}",
	"tooltip": false,
	"actions": { "on-click": "mode" }
},

"battery": {
	"interval": 5,
	"format": "{capacity}%",
	"format-charging": "charging {capacity}%",
	"states": { "warning": 30, "critical": 15 }
},

"pulseaudio": {
	"format": "{volume}%",
	"format-muted": "muted",
	"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},

"network": {
	"format-wifi": "wifi",
	"format-ethernet": "eth",
	"format-disconnected": "offline"
},

"tray": {
	"icon-size": 14,
	"spacing": 6
}
}
