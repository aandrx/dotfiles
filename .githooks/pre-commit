#!/usr/bin/env bash
# Pre-commit privacy gate. Enable with:
#   git config core.hooksPath .githooks
#
# The hook checks staged content only. Install gitleaks 8.30.1 or newer and
# make sure it is on PATH; the hook fails closed when it is unavailable.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/privacy-check.py"

if ! command -v python3 >/dev/null 2>&1; then
  printf 'pre-commit: python3 is required for privacy checks\n' >&2
  exit 1
fi
if [ ! -f "$CHECK" ]; then
  printf 'pre-commit: missing privacy checker: %s\n' "$CHECK" >&2
  exit 1
fi

python3 "$CHECK" --staged

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: gitleaks is required but was not found on PATH.
Install Gitleaks 8.30.1 from the official release, verify its checksum, and
put the binary on PATH.
EOF
  exit 1
fi

exec gitleaks protect --staged --redact=100 --ignore-gitleaks-allow \
  --log-level=warn --no-banner --config "$ROOT/.gitleaks.toml"
